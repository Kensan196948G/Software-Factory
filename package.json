{
  "name": "mirai-software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "みらいソフトウェアファクトリー 受付ステーション MVP（DeepSeek Harness / GitHub / OpenDesign / Cloudflare / Local PostgreSQL）",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "dev": "node scripts/local-run.mjs concurrently -k -n api,web -c blue,magenta \"tsx watch src/api/server.ts\" \"vite --config vite.config.ts\"",
    "dev:api": "node scripts/local-run.mjs tsx watch src/api/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "pnpm run build:api && pnpm run build:web",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "vite build --config vite.config.ts",
    "start": "node scripts/local-run.mjs node dist/api/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.ops.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit": "pnpm audit --prod --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/local-run.mjs vitest run --config vitest.config.ts && node scripts/local-run.mjs vitest run --config vitest.integration.config.ts",
    "test:unit": "node scripts/local-run.mjs vitest run --config vitest.config.ts tests/unit",
    "test:ops": "bash scripts/ops/tests/staging-autofollow.test.sh && bash scripts/ops/tests/prod-release-ci-gate.test.sh && bash scripts/ops/tests/onfailure-notify.test.sh && bash scripts/ops/tests/rto-drill.test.sh",
    "test:integration": "node scripts/local-run.mjs vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/local-run.mjs playwright test",
    "test:browser:approver": "playwright test --config playwright.approver.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "db:migrate": "node scripts/local-run.mjs tsx scripts/db.ts migrate",
    "db:rollback": "node scripts/local-run.mjs tsx scripts/db.ts rollback",
    "db:seed": "node scripts/local-run.mjs tsx scripts/db.ts seed",
    "db:reset": "node scripts/local-run.mjs tsx scripts/db.ts reset --yes",
    "db:verify": "node scripts/local-run.mjs tsx scripts/db.ts verify",
    "smoke": "node scripts/local-run.mjs tsx scripts/smoke.ts",
    "reminders": "node scripts/local-run.mjs tsx scripts/reminders.ts",
    "audit:archive": "node scripts/local-run.mjs tsx scripts/audit-archive.ts",
    "worker": "node scripts/local-run.mjs tsx src/worker/main.ts",
    "ops:backup": "node scripts/ops/with-env.mjs scripts/ops/backup.sh",
    "ops:restore-drill": "node scripts/ops/with-env.mjs scripts/ops/restore-drill.sh",
    "ops:release": "bash scripts/ops/release.sh",
    "ops:rollback": "bash scripts/ops/rollback.sh",
    "ops:reminders": "node scripts/ops/with-env.mjs tsx scripts/reminders.ts",
    "ops:audit:archive": "node scripts/ops/with-env.mjs tsx scripts/audit-archive.ts",
    "ops:revoke-sessions": "node scripts/ops/with-env.mjs tsx scripts/ops/revoke-sessions.ts",
    "ops:db:verify": "node scripts/ops/with-env.mjs tsx scripts/db.ts verify",
    "ops:prod:release": "bash scripts/ops/prod-release.sh",
    "ops:prod:rollback": "bash scripts/ops/prod-rollback.sh",
    "ops:prod:backup": "bash scripts/ops/prod-backup.sh",
    "ops:prod:restore-drill": "bash scripts/ops/prod-restore-drill.sh",
    "verify:all": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "ops:prod:offsite-drill": "bash scripts/ops/prod-offsite-drill.sh",
    "ops:prod:offsite-status": "tsx scripts/ops/offsite-status.ts",
    "ops:prod:acceptance": "tsx scripts/ops/prod-acceptance.ts",
    "ops:user-inventory": "tsx scripts/ops/user-inventory.ts",
    "ops:slo": "node scripts/ops/measure-slo.mjs",
    "ops:rpo-report": "node scripts/ops/rpo-report.mjs",
    "ops:repo-check": "node scripts/ops/repo-onboarding-check.mjs",
    "ops:prod:rto-drill": "bash scripts/ops/rto-drill.sh",
    "perf:list-filter": "tsx scripts/perf/list-filter-bench.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.2.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.5.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
