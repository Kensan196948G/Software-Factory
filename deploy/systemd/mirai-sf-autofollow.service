# 雛形: ~/.config/systemd/user/ へコピーして使う（有効化は Lead が行う。手順は
# docs/production/06-staging-parity-and-autofollow.md）。
# Staging を origin/main に追従させる。main が進んだときだけ配備し、失敗時は直前の
# リリースへ戻す（切替・再起動・healthz 確認は scripts/ops/release.sh に任せる）。
# 実行元は current ではなく常設のチェックアウト（リリースのデプロイに依存しないため）。
# スクリプトは配備前に main・clean・HEADが対象の祖先か確認し、実行元を変更せず target を配備する。
# diverged・dirty・feature ブランチは skip（exit 75）する。
# dev ツリーを main に保つか、専用チェックアウトを作って WorkingDirectory を差し替えること。
# 75 = 一時的な skip（別実行中、CI 待ち、作業ツリー不一致等）。failed にせず成功扱いにする。
# CI の恒久的な失敗は 1 で failed になる（気づけるようにする）。
[Unit]
Description=Mirai SF staging auto-follow to origin/main
After=network-online.target
Wants=network-online.target
# 失敗したら mirai-sf-onfailure@.service でローカル記録（alerts.jsonl＋journal err）。runbook §10
OnFailure=mirai-sf-onfailure@%n.service

[Service]
Type=oneshot
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/Projects/Software-Factory-Project
ExecStart=/usr/bin/env bash scripts/ops/staging-autofollow.sh
# systemd --user の環境に残った資格情報（失効した PAT 等）が gh の hosts.yml より
# 優先され、fetch が「Invalid username or token」で失敗するのを防ぐ。
# 認証は gh auth git-credential（~/.config/gh/hosts.yml）に一本化する。
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN GITHUB_PAT_TOKEN GITHUB_PERSONAL_ACCESS_TOKEN
# 75 は「一時的な skip」。timer の failed を増やさない
SuccessExitStatus=75
# pnpm install / build を含むため長めに取る（多重実行は flock で防ぐ）
TimeoutStartSec=1800
SyslogIdentifier=mirai-sf-autofollow
StandardOutput=journal
StandardError=journal
