# 雛形: 最新のバックアップを一時DBへ復元して検証し、一時DBを消す。本来のDBは書き換えない。
[Unit]
Description=Mirai SF restore drill
After=network.target

[Service]
Type=oneshot
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/share/mirai-sf/current
ExecStart=/usr/bin/env node scripts/ops/with-env.mjs scripts/ops/restore-drill.sh
