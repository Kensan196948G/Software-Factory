# 本番の外形監視。確認は /healthz の 200・status=ok・db.ok=true・environment=production・
# commit と current/release.env の COMMIT_SHA の一致（+ 任意で origin/main との比較）。
# 失敗（exit 1）は oneshot の failed として残り、systemctl --user --failed で見える。
# prod.conf（秘密値を含む設定）は読まない。release.env の COMMIT_SHA だけを照合する。
# リリースのデプロイに依存せず監視を続けるため、実行元は current ではなく常設のチェックアウト。
[Unit]
Description=Mirai SF production health check (/healthz, db.ok, environment=production, commit)
After=network.target

[Service]
Type=oneshot
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=MIRAI_SF_HEALTH_URL=http://127.0.0.1:8783/healthz
Environment=MIRAI_SF_HEALTH_ENV=production
Environment=MIRAI_SF_HOME=%h/.local/share/mirai-sf-prod
Environment=MIRAI_SF_HEALTH_STATE_FILE=%h/.local/state/mirai-sf-prod/healthcheck.json
WorkingDirectory=%h/Projects/Software-Factory-Project
ExecStart=/usr/bin/env node scripts/ops/healthcheck.mjs
TimeoutStartSec=60
SyslogIdentifier=mirai-sf-prod-healthcheck
StandardOutput=journal
StandardError=journal
